# Copy this file to .env.local for local reference, and add the same three
# values in Vercel's Project Settings -> Environment Variables (Vercel never
# reads .env.local - it only reads what's set in its own dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
