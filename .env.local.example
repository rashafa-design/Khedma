# Copy this file to .env.local for local reference, and add the same values
# in Vercel's Project Settings -> Environment Variables (Vercel never
# reads .env.local - it only reads what's set in its own dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The phone number clients are told to send the 2,000 EGP subscription
# payment to via Instapay or Vodafone Cash. Shown as plain text on the
# /client/subscribe page - not a secret, but it's real, so it lives here
# rather than hardcoded in the page.
NEXT_PUBLIC_PAYMENT_PHONE_NUMBER=
